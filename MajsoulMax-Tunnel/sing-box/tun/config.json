{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "https",
        "tag": "dns-direct",
        "domain_resolver": "dns-local",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "domain_resolver": "dns-direct",
        "server": "dns.google"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": "dns.google",
        "server": "dns-direct"
      },
      {
        "inbound": "tun-in",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "mtu": 9000,
      "interface_name": "MajsoulMax-Tunnel",
      "address": "172.19.0.1/28",
      "auto_route": true,
      "stack": "gvisor",
      "endpoint_independent_nat": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 12345
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "proxy",
      "domain_resolver": {
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      "server": "127.0.0.1",
      "server_port": 23410
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "direct",
      "tag": "bypass"
    }
  ],
  "route": {
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "inbound": "tun-in",
                "process_name": "MajsoulMax.exe"
              },
              {
                "inbound": "tun-in",
                "process_path_regex": ".*python.*"
              }
            ]
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "inbound": "tun-in",
                "domain_keyword": [
                  "majsoul",
                  "maj-soul",
                  "mahjongsoul",
                  "catmjstudio"
                ]
              },
              {
                "inbound": "tun-in",
                "process_name": [
                  "Jantama_MahjongSoul.exe",
                  "雀魂麻將.exe"
                ]
              }
            ]
          }
        ],
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "inbound": "tun-in",
            "process_name": [
              "Jantama_MahjongSoul.exe",
              "雀魂麻將.exe"
            ]
          },
          {
            "inbound": "tun-in",
            "domain_keyword": [
              "majsoul",
              "maj-soul",
              "mahjongsoul",
              "catmjstudio"
            ]
          }
        ],
        "outbound": "proxy"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "final": "direct"
  }
}